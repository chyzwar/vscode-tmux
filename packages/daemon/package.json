{
  "name": "vscode-tmux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "./dist/vscode-tmux",
  "scripts": {
    "build": "bun build --compile --target=bun-linux-x64 --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile=dist/vscode-tmux src/main.ts",
    "dev": "bun run src/main.ts daemon --foreground"
  },
  "dependencies": {
    "@vscode-tmux/protocol": "workspace:*"
  }
}
